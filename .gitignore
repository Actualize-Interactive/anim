# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
build-*/
out/
cmake-build-*/

# IDE files
.vs/
.vscode/
.idea/
*.swp
*~

# CMake generated files (from an accidental in-source build; out-of-source
# artifacts are already covered by the build directory rules above).
# Listed by name rather than as *.cmake so hand-written modules under cmake/
# are not silently ignored.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
Makefile

# Generated test outputs
Testing/

# Generated documentation (Doxygen XML, Exhale API rst, Sphinx HTML)
docs/doxygen/
docs/build/
docs/sphinx/api/

# Dear ImGui writes its window layout next to the working directory when the
# curve_visualization example is run.
imgui.ini

# OS-specific files
.DS_Store
Thumbs.db
